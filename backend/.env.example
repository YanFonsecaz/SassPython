# ============= AMBIENTE =============
AMBIENTE=desenvolvimento  # desenvolvimento | producao | teste
LOG_LEVEL=INFO

# ============= DATABASE =============
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seo_saas
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/seo_saas_test

# ============= SECRETS (gerar com `openssl rand -base64 32`) =============
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
ENCRYPTION_KEY=  # 32 bytes; usado p/ Fernet (criptografia TOTP)

# ============= URLs =============
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

# ============= REDIS =============
REDIS_URL=redis://localhost:6379/0

# ============= LLM PROVIDER =============
LLM_PROVIDER=openai  # openai | zhipuai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
OPENAI_API_KEY=
ZHIPUAI_API_KEY=

# Override de modelo por agente (default: usa LLM_MODEL)
INSERIDOR_LLM_MODEL=gpt-4.1
RERANKER_LLM_MODEL=gpt-4.1
REVISOR_LLM_MODEL=gpt-4.1
ENRIQUECEDOR_LLM_MODEL=gpt-4.1

# CWV — analisador (classificação determinística, alta frequência)
CWV_ANALISADOR_LLM_MODEL=gpt-4o-mini
CWV_ANALISADOR_LLM_TEMPERATURE=0.1
# CWV — pesquisador (tool-use + síntese, baixa frequência)
CWV_PESQUISADOR_LLM_MODEL=gpt-4.1
CWV_PESQUISADOR_LLM_TEMPERATURE=0.4
# Token para POST /api/admin/cwv/kb/reload (vazio = endpoint desabilitado)
CWV_ADMIN_RELOAD_TOKEN=

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# ============= PESQUISA WEB =============
SERPAPI_KEY=
GOOGLE_TRENDS_ENABLED=false

# ============= GERACAO DE IMAGEM =============
IMAGEM_MODEL=glm-image

# ============= WORKFLOW =============
WORKFLOW_TIMEOUT_SEGUNDOS=600
WORKFLOW_MAX_REVISOES=3
WORKFLOW_MAX_FEEDBACK=3
WORKFLOW_DISTRIBUIR_INLINKS_TIMEOUT=1800

# ============= INLINKS (julgamento unico) =============
INLINKS_CLEANER_TEMPERATURE=0.0
INLINKS_FORMATADOR_TEMPERATURE=0.0
# kill-switch do formatador do texto final (true=ativo)
INLINKS_FORMATADOR_ATIVO=true
# rollback do Distribuir para os pisos de cosine antigos (true=comportamento legado)
INLINKS_PISOS_LEGADO_DISTRIBUIR=false
# SPEC_Inlinks_Remover_Reranker_Redundante — kill-switches com GATE.
# Defaults true (comportamento atual). Só virar false em produção APÓS ~2 sem
# de funil confirmando que reranker/revisor não mudam resultados (ver spec §Gatilho).
INLINKS_RERANKER_ATIVO=true
INLINKS_REVISOR_ATIVO=true
# SPEC_Distribuir_Viabilidade_Pelo_Juiz — teto de julgamentos do juiz no Distribuir.
DISTRIBUIR_MAX_JULGAMENTOS=30
# SPEC_Inlinks_Cache_Duravel_Embeddings — L2 em Postgres atrás do Redis.
EMBEDDINGS_CACHE_TTL_DIAS=90
EMBEDDINGS_CACHE_MAX_LINHAS=50000
# SPEC_Inlinks_Descoberta_Automatica_Candidatas — timeout do job de indexação.
INDEXAR_WORKFLOW_TIMEOUT=1800

# ============= ARQ WORKERS =============
ARQ_MAX_JOBS=20
ARQ_JOB_TIMEOUT=2400

# ============= RATE LIMITS =============
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_GERAL_MAX=100
RATE_LIMIT_GERAL_WINDOW=60
RATE_LIMIT_FORGOT_MAX=3
RATE_LIMIT_FORGOT_WINDOW=3600
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW=60
RATE_LIMIT_MFA_MAX=10
RATE_LIMIT_MFA_WINDOW=900
LOGIN_RESPONSE_TIME=1.5

# ============= SEGURANCA =============
HIBP_FAIL_MODE=open  # open | closed | queue
PESQUISA_CACHE_TTL_DAYS=7

# ============= OBSERVABILITY =============
# LangSmith (free tier 5k traces/mes)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=seo-saas
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Sentry (free tier 5k erros/mes)
SENTRY_DSN=

# Prometheus /metrics endpoint (vazio = aberto; preencha p/ allowlist)
METRICS_ALLOWLIST=[]

# ============= UPLOADS =============
# Em prod no Render, montar Render Disk em /app/uploads (persistente entre deploys).
UPLOADS_DIR=/app/uploads
